{
  // Node >= 22.18 chạy thẳng file .ts (type stripping) nên chỉ dùng cú pháp xoá được:
  // không enum / namespace / parameter property, import phải ghi đuôi .ts.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
