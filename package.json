{
  "name": "backlog-bridge",
  "version": "0.1.7",
  "description": "Multi-space Backlog (Nulab) CLI for humans and AI agents, plus one-way sync between Backlog projects.",
  "mcpName": "io.github.mickey-ichi/backlog-bridge",
  "license": "MIT",
  "homepage": "https://github.com/mickey-ichi/backlog-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickey-ichi/backlog-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/mickey-ichi/backlog-bridge/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mickey-ichi"
  },
  "keywords": [
    "backlog",
    "nulab",
    "cli",
    "sync",
    "ai-agent",
    "claude",
    "codex",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "backlog-bridge": "bin/backlog-bridge.js"
  },
  "files": [
    ".agents",
    ".env.example",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README*.md",
    "bin",
    "config.example.json",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sync": "node src/sync.ts",
    "dry-run": "node src/sync.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build-plugin.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "audit:skills": "node scripts/audit-skills.mjs",
    "cli": "node src/cli.ts",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  }
}
